          ],
          "message": {
            "text": "A successful synthetic sign-in is followed by a successful sensitive change for the same principal inside the inclusive thirty-minute window."
          },
          "properties": {
            "erpsec.correlationId": "44d429dbcd54dded11f3178e771a057ae6b522fc5512bbac7723cb9b67df2014",
            "erpsec.findingId": "2c78c6876c92d2498353d12beb9e26eb4a933a4cef36d2f9d7878ea85729d870",
            "erpsec.limitation": "ERP009 identifies a supplied synthetic timing pattern only; it does not determine malicious intent, policy violation, or whether the change was approved.",
            "erpsec.remediation": "Review the authentication and change evidence against the authorized change record and escalate only through the documented investigation process.",
            "erpsec.requiredEvidenceTypes": [
              "change_event",
              "observed_event"
            ],
            "erpsec.ruleVersion": "1.0.0",
            "erpsec.severity": "medium"
          },
          "ruleId": "ERP009",
          "ruleIndex": 2
        }
      ],
      "tool": {
        "driver": {
          "name": "erp-security-evidence-workbench",
          "rules": [
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "A success after repeated failures from the same synthetic source can warrant review for credential misuse or an operational access issue."
              },
              "help": {
                "text": "ERP007 evaluates only supplied synthetic events and cannot establish attacker identity, intent, device context, or source-system completeness. Remediation: Review the correlated evidence chain, validate the principal and source context, and follow an authorized incident-response or access-support process."
              },
              "id": "ERP007",
              "properties": {
                "erpsec.fixedConditions": [
                  {
                    "default": 3,
                    "description": "Exactly three preceding failures are retained in each episode.",
                    "name": "failure_threshold"
                  },
                  {
                    "default": 600,
                    "description": "At most 600 seconds from the first retained failure through a strictly later success; the 600-second boundary is inclusive.",
                    "name": "maximum_window_seconds"
                  },
                  {
                    "default": "SIGN_IN",
                    "description": "Generic authentication action evaluated by this rule.",
                    "name": "action"
                  }
                ],
                "erpsec.parameters": [],
                "erpsec.requiredEvidenceTypes": [
                  "observed_event"
                ],
                "erpsec.ruleVersion": "1.0.0",
                "erpsec.severity": "high"
              },
              "shortDescription": {
                "text": "Failed sign-ins are followed by a successful sign-in"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "A successful sign-in from an address present in a supplied local indicator set can justify prioritized human review."
              },
              "help": {
                "text": "ERP008 uses only a user-supplied local synthetic indicator file; it performs no online lookup and does not assert that an address is malicious in the real world. Remediation: Validate the indicator source and event context, then follow the authorized triage process before taking any containment action."
              },
              "id": "ERP008",
              "properties": {
                "erpsec.fixedConditions": [
                  {
                    "default": "SIGN_IN",
                    "description": "Generic authentication action evaluated by this rule.",
                    "name": "action"
                  },
                  {
                    "default": "success",
                    "description": "Only explicitly successful synthetic events are correlated.",
                    "name": "outcome"
                  },
                  {
                    "default": "inclusive",
                    "description": "Event time must be inside the closed indicator-validity interval.",
                    "name": "indicator_validity"
                  }
                ],
                "erpsec.parameters": [],
                "erpsec.requiredEvidenceTypes": [
                  "observed_event",
                  "threat_indicator"
                ],
                "erpsec.ruleVersion": "1.0.0",
                "erpsec.severity": "high"
              },
              "shortDescription": {
                "text": "Successful sign-in matches a local synthetic threat indicator"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "A sensitive change shortly after authentication can warrant review of authorization and change-management context."
              },
              "help": {
                "text": "ERP009 identifies a supplied synthetic timing pattern only; it does not determine malicious intent, policy violation, or whether the change was approved. Remediation: Review the authentication and change evidence against the authorized change record and escalate only through the documented investigation process."
              },
              "id": "ERP009",
              "properties": {
                "erpsec.fixedConditions": [
                  {
                    "default": 1800,
                    "description": "Sensitive change must occur strictly after the successful sign-in and no more than 1,800 seconds later.",
                    "name": "maximum_window_seconds"
                  },
                  {
                    "default": [
                      "DISABLE_AUDIT",
                      "GRANT_PRIVILEGE"
                    ],
                    "description": "Fixed vendor-neutral synthetic change actions.",
                    "name": "sensitive_actions"
                  },
                  {
                    "default": "success",
                    "description": "Both the sign-in and change must have successful outcomes.",
                    "name": "outcome"
                  }
                ],
                "erpsec.parameters": [],
                "erpsec.requiredEvidenceTypes": [
                  "change_event",
                  "observed_event"
                ],
                "erpsec.ruleVersion": "1.0.0",
                "erpsec.severity": "medium"
              },
              "shortDescription": {
                "text": "Successful sign-in precedes a sensitive change"
              }
            }
          ],
          "version": "0.2.0rc1"
        }
      }
    }
  ],
  "version": "2.1.0"
